  sheetUrl: "https://script.google.com/macros/s/AKfycbw8KfFJWjqy7RSdNHgBvWW5tSjmjAZ-w50zyquR1C4gsxU9itslXb74G6PqwG8U6sTgSQ/exec",
  whatsapp: "6288267051280",
  music: { file:"musik.mp3", start:0, volume:0.7 },
  journey: [
    { t:"Dikenalkan Keluarga", d:"Awal perkenalan", p:"Allah mempertemukan kami lewat perantara keluarga. Dari perkenalan sederhana itu, tumbuh niat baik untuk saling mengenal dengan cara yang diridhai-Nya." },
    { t:"Khitbah", d:"15 Agustus 2026", p:"Setelah Fiqa menuntaskan studi S1-nya, keluarga besar kami bertemu dan lamaran pun diterima dengan penuh syukur." },
    { t:"Walimatul 'Urs", d:"25 Desember 2026", p:"Dengan izin Allah, kami mengikat janji suci dalam akad nikah, memulai perjalanan baru menuju sakinah, mawaddah, warahmah." }
  ],
  adab: [
    ["Memperhatikan waktu shalat dan tidak meninggalkan shalat", '<path d="M12 3l1.5 3M6 21V11h12v10M4 21h16M9 21v-5a3 3 0 0 1 6 0v5M7 11c0-3 2-5 5-5s5 2 5 5"/>'],
    ["Tidak bersentuhan dengan yang bukan mahram", '<path d="M3 13l3-3 3 3M6 10v8M21 13l-3-3-3 3M18 10v8"/><path d="M4 4l16 16"/>'],
    ["Memperhatikan adab makan dan minum", '<path d="M6 3v8a2 2 0 0 0 4 0V3M8 11v10M17 3c-2 2-2 7 0 9v9"/>'],
    ["Berpakaian sopan dan menutup aurat", '<path d="M8 3l-5 4 3 4 2-1v11h8V10l2 1 3-4-5-4c-1 2-2.5 3-4 3S9 5 8 3z"/>'],
    ["Memperhatikan kepantasan dalam setiap foto yang diambil", '<rect x="3" y="7" width="18" height="13" rx="2"/><circle cx="12" cy="13.5" r="3.5"/><path d="M8 7l2-3h4l2 3"/>'],
    ["Menghadiri undangan dengan niat mengamalkan sunnah Rasul", '<path d="M4 5h6a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4zM20 5h-6a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h6z"/>'],
    ["Mendoakan pengantin", '<path d="M8 21v-6l-3-4V5l3 4M16 21v-6l3-4V5l-3 4M8 9l4 3 4-3"/>']
  ]
};
/* Data khusus versi undangan ini (dibuat otomatis) */
const V = {"id": "wanita", "couple": "Fiqa & Fajri", "countdown": "2026-12-25T15:00:00+07:00", "events": [{"name": "Akad Nikah", "code": "AKD", "tone": "", "date": "Jumat, 25 Desember 2026", "time": "15.00 WIB – selesai", "place": "Kediaman keluarga mempelai wanita", "addr": "Jl. Abdul Gaffar RT 07 RW 02, Desa Sarang Burung, Jambi", "map": "https://maps.app.goo.gl/ARbePCEN5WCDTWuZ6"}, {"name": "Resepsi", "code": "RSP", "tone": "", "date": "Ahad, 3 Januari 2027", "time": "10.00 WIB – selesai", "place": "Kediaman keluarga mempelai wanita", "addr": "Jl. Abdul Gaffar RT 07 RW 02, Desa Sarang Burung, Jambi", "map": "https://maps.app.goo.gl/ARbePCEN5WCDTWuZ6"}], "eventName": "akad nikah & resepsi", "journeyExtra": []};
/* ============================================================== */

const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const store = { get(k){ try{ return JSON.parse(localStorage.getItem(k)); }catch(e){ return null; } }, set(k,v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} } };

/* nama tamu dari URL: …/index.html?to=Bapak+Ahmad */
let guest = "";
try{ guest = (new URLSearchParams(location.search).get("to") || "").trim().slice(0,60); }catch(e){}
if(guest){ $("#guestName").textContent = guest; $("#rName").value = guest; $("#wName").value = guest; }

/* ---------- sampul & musik ---------- */
const cover = $("#cover"), audio = $("#bgm"), mBtn = $("#music");
audio.src = CONFIG.music.file;
let fadeT, userPaused = false;
const fadeTo = (target, ms, done) => {
  clearInterval(fadeT);
  const step = (target - audio.volume) / (ms / 50);
  fadeT = setInterval(() => {
    const v = audio.volume + step;
    if((step >= 0 && v >= target) || (step < 0 && v <= target)){ audio.volume = target; clearInterval(fadeT); done && done(); }
    else audio.volume = Math.min(1, Math.max(0, v));
  }, 50);
};
const playMusic = () => { audio.volume = 0; return audio.play().then(() => { mBtn.classList.add("play"); fadeTo(CONFIG.music.volume, 2500); }).catch(() => mBtn.classList.remove("play")); };
const pauseMusic = () => fadeTo(0, 600, () => { audio.pause(); mBtn.classList.remove("play"); });
$("#openBtn").addEventListener("click", () => {
  cover.classList.add("open"); document.body.classList.remove("locked");
  setTimeout(() => cover.classList.add("gone"), 1300);
  mBtn.classList.add("show");
  try{ audio.currentTime = CONFIG.music.start; }catch(e){}
  playMusic();
});
mBtn.addEventListener("click", () => { if(audio.paused){ userPaused = false; playMusic(); } else { userPaused = true; pauseMusic(); } });
document.addEventListener("visibilitychange", () => {
  if(!mBtn.classList.contains("show")) return;
  if(document.hidden){ if(!audio.paused) audio.pause(); } else if(!userPaused){ playMusic(); }
});

/* ---------- hitung mundur ---------- */
const target = new Date(V.countdown).getTime();
const tick = () => {
  const s = Math.max(0, Math.floor((target - Date.now())/1000));
  const v = { d:Math.floor(s/86400), h:Math.floor(s%86400/3600), m:Math.floor(s%3600/60), s:s%60 };
  document.querySelectorAll("#cd b").forEach(b => b.textContent = String(v[b.dataset.k]).padStart(2,"0"));
};
tick(); setInterval(tick, 1000);

/* ---------- boarding pass ---------- */
const barcode = txt => {
  let x = 0, bars = "", seed = [...txt].reduce((a,c) => a*31 + c.charCodeAt(0), 7);
  while(x < 168){ seed = (seed*1103515245 + 12345) % 2147483648; const w = 1 + seed % 4; if(seed % 3) bars += `<rect x="${x}" y="0" width="${w}" height="40"/>`; x += w + 1 + (seed>>3)%2; }
  return `<svg class="barcode" viewBox="0 0 170 40" preserveAspectRatio="none" fill="var(--burgundy-dk)" aria-hidden="true">${bars}</svg>`;
};
$("#tickets").innerHTML = V.events.map((e,i) => `
  <article class="ticket ${i%2 ? "slide-r" : "slide-l"} ${e.tone}">
    <div class="top"><b>${e.name}</b><span>GATE ${String(i+1).padStart(2,"0")} · ${e.code}</span></div>
    <div class="body">
      <div><small>Tanggal</small><div class="v">${e.date}</div></div>
      <div><small>Pukul</small><div class="v">${e.time}</div></div>
      <div class="full"><small>Lokasi</small><div class="v">${e.place}</div><div style="font-size:14px">${e.addr}</div></div>
    </div>
    <div class="tear"></div>
    <div class="foot">${barcode(e.name)}
      <a class="btn ${e.tone ? "btn-olive" : "btn-dark"}" href="${e.map}" target="_blank" rel="noopener"><svg><use href="#pin"/></svg> Lihat Lokasi</a>
    </div>
  </article>`).join("");

/* ---------- our journey ---------- */
const journey = CONFIG.journey.concat(V.journeyExtra || []);
const track = $("#track"), dots = $("#dots");
track.innerHTML = journey.map(j => `<div class="slide"><h4>${j.t}</h4><div class="d">${j.d}</div><p>${j.p}</p></div>`).join("");
dots.innerHTML = journey.map((_,i) => `<button type="button" aria-label="Kisah ${i+1}"></button>`).join("");
let cur = 0, timer;
const go = i => {
  cur = (i + journey.length) % journey.length;
  track.style.transform = `translateX(-${cur*100}%)`;
  [...dots.children].forEach((d,k) => d.classList.toggle("on", k === cur));
  clearInterval(timer); timer = setInterval(() => go(cur+1), 6500);
};
$(".nav.p").addEventListener("click", () => go(cur-1));
$(".nav.n").addEventListener("click", () => go(cur+1));
[...dots.children].forEach((d,k) => d.addEventListener("click", () => go(k)));
let sx = null;
track.addEventListener("touchstart", e => sx = e.touches[0].clientX, {passive:true});
track.addEventListener("touchend", e => { if(sx === null) return; const dx = e.changedTouches[0].clientX - sx; if(Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1)); sx = null; });
go(0);

/* ---------- adab ---------- */
$("#adab").innerHTML = CONFIG.adab.map(([t,p]) => `<div class="rv"><div class="ic"><svg viewBox="0 0 24 24">${p}</svg></div><p>${t}</p></div>`).join("");

/* ---------- koneksi Google Sheets ---------- */
const online = !!CONFIG.sheetUrl;
const send = data => fetch(CONFIG.sheetUrl, { method:"POST", body: JSON.stringify(Object.assign({ versi:V.id }, data)) })
  .then(r => r.json()).then(j => { if(!j.ok) throw new Error(j.error || "gagal"); return j; });

/* ---------- konfirmasi kehadiran ---------- */
const RKEY = "rsvp-" + V.id;
let count = 1;
const setCount = n => { count = Math.min(5, Math.max(1, n)); $("#rCount").textContent = count + " orang"; };
$("#minus").addEventListener("click", () => setCount(count - 1));
$("#plus").addEventListener("click", () => setCount(count + 1));
const syncHadir = () => { $("#countWrap").style.display = document.querySelector('input[name="hadir"]:checked').value === "Hadir" ? "" : "none"; };
document.querySelectorAll('input[name="hadir"]').forEach(r => r.addEventListener("change", syncHadir));
const waText = (n, h, c) => `Assalamu'alaikum, saya ${n || "…"} ${h === "Hadir" ? `insya Allah hadir (${c} orang)` : "mohon maaf berhalangan hadir"} di ${V.eventName} ${V.couple}.`;
const updateWa = () => {
  const h = document.querySelector('input[name="hadir"]:checked').value;
  $("#waLink").href = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(waText($("#rName").value.trim(), h, count))}`;
};
["input","change","click"].forEach(ev => $("#rsvp").addEventListener(ev, updateWa));
const showOk = r => {
  $("#rsvp").style.display = "none"; $("#rOk").classList.add("show");
  $("#rOkText").textContent = r.hadir === "Hadir"
    ? `Konfirmasi ${r.nama} tercatat: insya Allah hadir, ${r.jumlah} orang. Sampai jumpa di hari bahagia kami.`
    : `Konfirmasi ${r.nama} tercatat. Terima kasih atas doa dan kabarnya.`;
};
$("#rEdit").addEventListener("click", () => { $("#rOk").classList.remove("show"); $("#rsvp").style.display = ""; });
const saved = store.get(RKEY);
if(saved){
  $("#rName").value = saved.nama; setCount(saved.jumlah || 1);
  document.querySelector(`input[name="hadir"][value="${saved.hadir}"]`)?.click();
  showOk(saved);
}
syncHadir(); updateWa();
$("#rsvp").addEventListener("submit", async e => {
  e.preventDefault();
  const note = $("#rNote"), btn = $("#rBtn");
  const r = { nama: $("#rName").value.trim(), hadir: document.querySelector('input[name="hadir"]:checked').value, jumlah: count };
  if(r.hadir !== "Hadir") r.jumlah = 0;
  if(!r.nama){ note.textContent = "Mohon isi nama Anda terlebih dahulu."; $("#rName").focus(); return; }
  if($("#rWeb").value) return;
  if(!online){ store.set(RKEY, r); showOk(r); return; }
  btn.disabled = true; note.textContent = "Mengirim…";
  try{ await send(Object.assign({ type:"rsvp" }, r)); store.set(RKEY, r); note.textContent = ""; showOk(r); }
  catch(err){ note.innerHTML = 'Maaf, konfirmasi belum terkirim. Coba lagi, atau <a href="' + $("#waLink").href + '" target="_blank" rel="noopener">kirim lewat WhatsApp</a>.'; }
  finally{ btn.disabled = false; }
});

/* ---------- salin rekening / alamat ---------- */
document.querySelectorAll("[data-copy]").forEach(b => b.addEventListener("click", async () => {
  const t = document.getElementById(b.dataset.copy).textContent.trim();
  const note = $("#copyNote");
  try{ await navigator.clipboard.writeText(t); note.textContent = "Tersalin: " + t; }
  catch(e){ note.textContent = "Salin manual: " + t; }
}));

/* ---------- ucapan & doa ---------- */
const WKEY = "ucapan-fiqa-fajri";
const ago = t => {
  const s = (Date.now() - new Date(t).getTime())/1000;
  if(!(s >= 0)) return "";
  if(s < 60) return "baru saja";
  if(s < 3600) return Math.floor(s/60) + " menit lalu";
  if(s < 86400) return Math.floor(s/3600) + " jam lalu";
  if(s < 2592000) return Math.floor(s/86400) + " hari lalu";
  return new Date(t).toLocaleDateString("id-ID", { day:"numeric", month:"long", year:"numeric" });
};
let wishes = [];
const renderW = (fresh) => {
  $("#wCount").textContent = wishes.length ? wishes.length + " ucapan" : "";
  $("#wishes").innerHTML = wishes.length
    ? wishes.map((w,i) => `<div class="wish${fresh && i === 0 ? " new" : ""}"><b>${esc(w.nama)}</b><br>${esc(w.ucapan)}<time datetime="${esc(w.waktu)}">${ago(w.waktu)}</time></div>`).join("")
    : `<p class="empty">Belum ada ucapan. Jadilah yang pertama mendoakan kedua mempelai.</p>`;
};
const loadWishes = () => {
  if(!online){ wishes = store.get(WKEY) || []; renderW(); return; }
  fetch(CONFIG.sheetUrl + "?action=ucapan").then(r => r.json())
    .then(j => { wishes = j.data || []; renderW(); })
    .catch(() => { wishes = []; $("#wishes").innerHTML = `<p class="empty">Ucapan belum bisa dimuat. Coba muat ulang halaman.</p>`; });
};
loadWishes();
$("#wishForm").addEventListener("submit", async e => {
  e.preventDefault();
  const note = $("#wNote"), btn = $("#wBtn");
  const w = { nama: $("#wName").value.trim(), ucapan: $("#wText").value.trim(), waktu: new Date().toISOString() };
  if(!w.nama || !w.ucapan){ note.textContent = "Mohon isi nama dan ucapan Anda."; return; }
  if($("#wWeb").value) return;
  if(!online){ wishes.unshift(w); store.set(WKEY, wishes); $("#wText").value = ""; note.textContent = ""; renderW(true); return; }
  btn.disabled = true; note.textContent = "Mengirim…";
  try{ await send({ type:"ucapan", nama:w.nama, ucapan:w.ucapan }); wishes.unshift(w); $("#wText").value = ""; note.textContent = "Terima kasih, ucapan Anda sudah tersimpan."; renderW(true); }
  catch(err){ note.textContent = "Maaf, ucapan belum terkirim. Periksa koneksi lalu coba lagi."; }
  finally{ btn.disabled = false; }
});

/* ---------- animasi saat di-scroll ---------- */
const io = new IntersectionObserver(es => es.forEach(en => { if(en.isIntersecting){ en.target.classList.add("in"); io.unobserve(en.target); } }), { threshold:.15 });
document.querySelectorAll(".rv,.stamp-in,.slide-l,.slide-r,.drop").forEach(el => io.observe(el));
}
</script>
</body>
</html>
