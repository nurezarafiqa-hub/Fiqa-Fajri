<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Undangan Pernikahan Fiqa & Fajri</title>
<meta name="description" content="Akad nikah & resepsi Nureza Rafiqa dan Muhammad Al Fajri — Desa Sarang Burung, Jambi.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Cormorant+Garamond:wght@500;600;700&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Pinyon+Script&display=swap" rel="stylesheet">
<style>
/*
VOICE  : khidmat, hangat, rapi — undangan walimah bernuansa paspor perjalanan.
IDEA   : sebuah paspor bersampul burgundy; dibuka, isinya halaman data, cap visa, perangko, dan boarding pass.
PICTURE: lambang bermahkota di sampul, ilustrasi pasangan, polaroid orang tua, halaman visa penuh cap.
COLOUR : dark burgundy (dominan), olive gelap (pendukung), emas champagne (aksen), kertas krem.
TYPE   : Aref Ruqaa (Arab), Cormorant (judul), Pinyon Script (nama), Courier Prime (teks ketik paspor).
*/
:root{
  color-scheme:light;
  --burgundy:#4A0E1C;
  --burgundy-dk:#2E0710;
  --burgundy-soft:#6B2333;
  --olive:#3F4A1F;
  --olive-dk:#2A3214;
  --olive-soft:#9AA36B;
  --gold:#D4B26A;
  --gold-soft:#EAD9AE;
  --paper:#FBF6EC;
  --paper-2:#F3EAD8;
  --ink:#3A1219;
  --muted:#7A5A5F;
}
*{box-sizing:border-box;min-width:0}
img{max-width:100%;height:auto}
html{scroll-behavior:smooth}
body{
  margin:0;color:var(--ink);overflow-x:clip;
  font:15.5px/1.7 "Courier Prime",ui-monospace,monospace;
  background:
    radial-gradient(circle at 20% 10%, rgba(255,255,255,.06), transparent 40%),
    repeating-linear-gradient(45deg, var(--olive-dk) 0 2px, transparent 2px 14px),
    var(--olive);
}
body.locked{overflow:hidden;height:100vh}
.ar-name{font-family:"Aref Ruqaa",serif;line-height:2;direction:rtl;unicode-bidi:isolate;font-weight:400;text-align:center;display:block;width:100%}
.ar{font-family:"Aref Ruqaa",serif;direction:rtl;unicode-bidi:isolate;text-align:center;line-height:2.1}
.title{font-family:"Cormorant Garamond",serif;font-weight:600;letter-spacing:.04em;line-height:1.05;text-wrap:balance}
.script{font-family:"Pinyon Script",cursive}

/* ===== bingkai halaman ===== */
.book{max-width:460px;margin:0 auto;background:var(--paper);min-height:100vh;
  box-shadow:0 0 0 1px rgba(0,0,0,.08),0 30px 80px rgba(0,0,0,.35);position:relative}
section{position:relative;padding:56px 26px;text-align:center;overflow:hidden}
.orn-band{background:var(--burgundy);height:44px;display:flex;align-items:center;justify-content:center;gap:12px;color:var(--gold);padding:0 24px}
.orn-band::before,.orn-band::after{content:"";flex:1;max-width:150px;height:1px;background:linear-gradient(90deg,transparent,var(--gold))}
.orn-band::after{background:linear-gradient(90deg,var(--gold),transparent)}
.orn-band svg{width:58px;height:16px}
.airmail{height:16px;background:repeating-linear-gradient(-45deg,
  var(--burgundy) 0 14px,var(--paper) 14px 22px,var(--olive) 22px 36px,var(--paper) 36px 44px)}
.band-line{height:10px;background:var(--burgundy-dk)}
.divider{display:flex;align-items:center;gap:10px;justify-content:center;margin:12px auto 26px;max-width:260px;color:var(--burgundy)}
.divider::before,.divider::after{content:"";flex:1;border-top:1.5px dashed currentColor;opacity:.6}
.divider svg{width:22px;height:22px;flex:none}
h2.title{font-size:clamp(32px,9vw,42px);color:var(--burgundy);margin:0}
.deco{position:absolute;pointer-events:none;opacity:.35;width:150px;z-index:0}
section>*{position:relative;z-index:1}
section>.deco{position:absolute;z-index:0}

/* ===== reveal animation ===== */
.rv{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease}
.rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}.cover{transition:none!important}}

/* ===== SAMPUL PASPOR ===== */
.cover{position:fixed;inset:0;z-index:50;display:flex;justify-content:center;perspective:1600px}
.cover-inner{width:100%;max-width:460px;height:100%;color:var(--gold);text-align:center;
  display:flex;flex-direction:column;align-items:center;justify-content:center;padding:28px;
  background:
    radial-gradient(ellipse at 50% 35%, rgba(255,255,255,.08), transparent 60%),
    repeating-linear-gradient(0deg, rgba(0,0,0,.05) 0 1px, transparent 1px 3px),
    var(--burgundy);
  box-shadow:inset 14px 0 30px rgba(0,0,0,.35);
  transform-origin:left center;transition:transform 1.3s cubic-bezier(.6,.05,.3,1),opacity 1.3s}
.cover.open .cover-inner{transform:rotateY(-110deg);opacity:0}
.cover.gone{display:none}
.cover h1{font-family:"Cormorant Garamond",serif;font-weight:500;font-size:clamp(46px,14vw,62px);letter-spacing:.08em;margin:0;line-height:1}
.cover .sub{font-family:"Cormorant Garamond",serif;font-size:19px;letter-spacing:.14em;margin:6px 0 18px}
.crest{width:min(74vw,300px);height:auto;filter:drop-shadow(0 4px 10px rgba(0,0,0,.35))}
.cover .names{font-family:"Pinyon Script",cursive;font-size:clamp(38px,11vw,48px);color:var(--gold-soft);margin:6px 0 0;line-height:1.2}
.cover .ar-name{font-size:clamp(44px,13vw,58px);color:var(--gold-soft);margin:8px 0 2px;line-height:1.5}
.cover .latin{font-size:14px;letter-spacing:.3em;color:var(--olive-soft);text-transform:uppercase}
.guest{margin-top:24px;color:var(--paper)}
.guest small{display:block;font-size:13px;opacity:.85}
.guest b{display:block;font-size:19px;margin-top:6px;color:var(--gold-soft)}
.btn{display:inline-flex;align-items:center;gap:10px;min-height:46px;padding:0 24px;border:0;border-radius:999px;
  font:700 15px "Courier Prime",monospace;cursor:pointer;text-decoration:none;transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px)}
.btn:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.btn-gold{background:var(--gold);color:var(--burgundy-dk);box-shadow:0 6px 18px rgba(0,0,0,.3);margin-top:22px}
.btn-dark{background:var(--burgundy);color:var(--paper);box-shadow:0 6px 16px rgba(74,14,28,.35)}
.btn-olive{background:var(--olive);color:var(--paper)}
.btn svg{width:18px;height:18px}

/* ===== HERO ===== */
.hero{padding:40px 22px 46px}
.hero .lead{font-style:italic;letter-spacing:.06em}
.hero-art{width:100%;max-width:380px;margin:10px auto 0;display:block}
.hero .ar-name{font-size:clamp(40px,12vw,54px);color:var(--burgundy);line-height:1.9;margin:4px 0 0}
.hero .script{font-size:clamp(46px,13vw,58px);color:var(--burgundy);margin:6px 0 4px;line-height:1.15}
.hero .date{font-weight:700;letter-spacing:.06em}

/* ===== AYAT ===== */
.ayat{background:var(--paper-2)}
.ayat .ar{font-size:26px;line-height:2.1;color:var(--burgundy-dk);margin:0 auto 14px;text-align:center;max-width:380px}
.ayat p{font-style:normal;margin:0 auto;max-width:360px;text-align:center}
.ayat cite{display:block;margin-top:14px;font-style:normal;font-weight:700;color:var(--olive-dk)}

/* ===== LOVE PASSPORT BAR ===== */
.pbar{background:var(--burgundy);color:var(--paper);padding:22px 16px;text-align:center}
.pbar h3{margin:0 0 14px;font-size:22px;letter-spacing:.12em;font-weight:700}
.pbar .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;font-size:13px;text-align:center}
.pbar small{display:block;font-size:11px;opacity:.75;color:var(--gold-soft)}
.mrz{margin:16px auto 0;font-size:10.5px;letter-spacing:.1em;color:var(--olive-soft);line-height:1.6;text-align:center;word-break:break-all;max-width:340px}

/* ===== SALAM ===== */
.bism{font-size:30px;color:var(--burgundy);margin:0 0 10px}

/* ===== MEMPELAI ===== */
.person{text-align:left;margin:0 auto}
.person.r{text-align:right}
.photo{width:62%;aspect-ratio:4/5;border:2.5px dashed var(--burgundy);padding:8px;background:var(--paper);position:relative}
.person.r .photo{margin-left:auto}
.photo img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block}
.photo .stamp{position:absolute;right:-22px;bottom:-14px;transform:rotate(-14deg);width:78px;opacity:.9}
.person.r .photo .stamp{right:auto;left:-22px;transform:rotate(12deg)}
.person .role{font-size:13px;color:var(--muted);margin-top:20px}
.person .ar-name{font-size:clamp(28px,8vw,34px);color:var(--burgundy);line-height:1.9;margin:0;text-align:inherit}
.person .nm{font-weight:700;font-size:20px;color:var(--gold);line-height:1.3;text-shadow:0 1px 0 rgba(0,0,0,.08);filter:brightness(.8)}
.person .par{font-size:13.5px;margin-top:8px;line-height:1.5}
.plane-sep{margin:26px auto}

/* ===== COUNTDOWN ===== */
.count{position:relative;background:var(--paper-2);color:var(--burgundy);padding:64px 18px 72px;text-align:center;overflow:hidden}
.count .map{position:absolute;left:50%;top:50%;width:125%;max-width:none;height:auto;transform:translate(-50%,-50%);opacity:.55;pointer-events:none}
.count>*:not(.map){position:relative}
.count h3{font-family:"Cormorant Garamond",serif;font-size:32px;margin:0 0 4px;font-weight:600}
.cd{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:20px 0 6px}
.cd div{background:var(--burgundy);color:var(--gold);border-radius:12px;padding:12px 4px;box-shadow:0 8px 18px rgba(46,7,16,.25),inset 0 -4px 0 var(--gold)}
.cd b{display:block;font-size:clamp(24px,8vw,32px);line-height:1.1}
.cd small{font-size:12px;color:var(--gold-soft)}

/* ===== BOARDING PASS (ACARA) ===== */
.events{background:var(--paper)}
.ticket{position:relative;background:#fff;border-radius:16px;text-align:left;margin:0 auto 26px;
  box-shadow:0 10px 26px rgba(46,7,16,.16);overflow:hidden}
.ticket .top{background:var(--burgundy);color:var(--paper);padding:14px 18px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.ticket .top b{font-family:"Cormorant Garamond",serif;font-size:clamp(21px,6.4vw,26px);white-space:nowrap;line-height:1.2;font-weight:600;letter-spacing:.03em}
.ticket .top span{font-size:11px;letter-spacing:.14em;color:var(--gold-soft);white-space:nowrap}
.ticket.olive .top{background:var(--olive)}
.ticket .body{padding:16px 18px 10px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px 14px}
.ticket .body .full{grid-column:1/-1}
.ticket small{display:block;font-size:11.5px;color:var(--muted);letter-spacing:.06em}
.ticket .v{font-weight:700;font-size:15px;line-height:1.4}
.ticket .tear{position:relative;border-top:2px dashed #E3D4C2;margin:6px 0 0}
.ticket .tear::before,.ticket .tear::after{content:"";position:absolute;top:-12px;width:22px;height:22px;border-radius:50%;background:var(--paper)}
.ticket .tear::before{left:-11px}.ticket .tear::after{right:-11px}
.ticket .foot{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px}
.barcode{height:40px;flex:1;max-width:170px}
.ticket .btn{min-height:44px;padding:0 16px;font-size:13.5px}

/* ===== FORM ===== */
form{text-align:left;display:grid;gap:12px}
label.l{font-size:13px;color:var(--muted)}
input[type=text],input[type=number],textarea{width:100%;font:16px "Courier Prime",monospace;padding:12px 14px;border:1.5px solid #E2D2BF;border-radius:10px;background:#fff;color:var(--ink)}
textarea{min-height:100px;resize:vertical}
.radio{display:flex;align-items:center;gap:10px;min-height:36px;cursor:pointer}
.radio input{width:18px;height:18px;accent-color:var(--burgundy)}
.note{font-size:13px;color:var(--olive-dk);min-height:1em}
.box{border:2px dashed var(--burgundy);border-radius:14px;padding:22px 18px;background:#fff}

/* ===== ADAB ===== */
.adab{background:var(--paper-2)}
.adab .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 14px}
.adab .grid>:last-child:nth-child(odd){grid-column:1/-1;max-width:50%;margin:0 auto}
.adab .ic{width:84px;height:84px;margin:0 auto 10px;border-radius:50%;background:#E9D8D3;display:grid;place-items:center}
.adab .ic svg{width:46px;height:46px;stroke:var(--burgundy);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.adab p{margin:0;font-size:13.5px;line-height:1.45}

/* ===== DOA ===== */
.doa .ar{font-size:26px;line-height:2;color:var(--burgundy)}

/* ===== UCAPAN ===== */
.wishes{margin-top:18px;display:grid;gap:10px;text-align:left;max-height:340px;overflow:auto}
.wish{background:var(--paper-2);border-left:4px solid var(--olive);border-radius:8px;padding:10px 14px;font-size:14px}
.wish b{color:var(--burgundy)}
.empty{font-size:13.5px;color:var(--muted);text-align:center}

/* ===== FOOTER ===== */
footer{background:var(--burgundy-dk);color:var(--gold-soft);text-align:center;padding:34px 20px 90px}
footer .ar-name{font-size:42px;line-height:1.5;margin:0}
footer p{margin:6px 0 0;font-size:13px;color:var(--paper);opacity:.85}

/* ===== MUSIK ===== */
.music{position:fixed;right:max(16px,calc(50% - 214px));bottom:18px;z-index:40;width:48px;height:48px;border-radius:50%;
  border:2px solid var(--gold);background:var(--burgundy);color:var(--gold);display:none;place-items:center;cursor:pointer}
.music.show{display:grid}
.music svg{width:22px;height:22px}
.music.play svg{animation:spin 4s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}


/* ===== ANIMASI TAMBAHAN ===== */
.stamp-in{opacity:0;transform:rotate(var(--r,0deg)) scale(1.45);transition:opacity .35s ease,transform .45s cubic-bezier(.2,1.6,.4,1)}
.stamp-in.in{opacity:var(--o,1);transform:rotate(var(--r,0deg)) scale(1)}
.slide-l{opacity:0;transform:translateX(-40px);transition:opacity 1s ease,transform 1s ease}
.slide-r{opacity:0;transform:translateX(40px);transition:opacity 1s ease,transform 1s ease}
.slide-l.in,.slide-r.in{opacity:1;transform:none}
.drop{opacity:0;transform:translateY(-30px) rotate(var(--r,0deg));transition:opacity 1s ease,transform 1.1s cubic-bezier(.2,.9,.3,1.2)}
.drop.in{opacity:1;transform:rotate(var(--r,0deg))}
@media (prefers-reduced-motion:reduce){.stamp-in,.slide-l,.slide-r,.drop{opacity:var(--o,1);transform:rotate(var(--r,0deg));transition:none}}

/* ===== ALBUM ORANG TUA ===== */
.album{background:var(--paper-2);padding-bottom:70px}
.album .sub{max-width:340px;margin:-10px auto 26px;font-size:14.5px}
.polas{position:relative;max-width:400px;margin:0 auto}
.pola{position:relative;width:82%;margin:0;box-shadow:0 14px 28px rgba(46,7,16,.22),0 2px 4px rgba(46,7,16,.15);background:#E9C8BE}
.pola img{display:block;width:100%;height:auto}
.pola.b{margin:7% 0 0 auto;z-index:2}
.pola .tape{position:absolute;top:-14px;left:50%;width:42%;height:30px;transform:translateX(-50%) rotate(-3deg);
  background:repeating-linear-gradient(45deg,rgba(74,14,28,.55) 0 8px,rgba(234,217,174,.55) 8px 16px);box-shadow:0 1px 2px rgba(0,0,0,.15)}
.pola.b .tape{background:repeating-linear-gradient(45deg,rgba(63,74,31,.55) 0 8px,rgba(234,217,174,.55) 8px 16px);transform:translateX(-50%) rotate(4deg)}
.pola figcaption{position:absolute;left:26%;right:5%;bottom:1.5%;height:16%;display:flex;flex-direction:column;justify-content:center;text-align:left;line-height:1.25;gap:2px}
.pola figcaption .s{font-family:"Pinyon Script",cursive;font-size:clamp(15px,4.3vw,19px);color:var(--burgundy);white-space:nowrap}
.pola figcaption .n{font-size:clamp(9.5px,2.6vw,11px);color:var(--ink);font-weight:700}
.album .pr{position:absolute;width:24%;z-index:3;filter:drop-shadow(0 4px 6px rgba(46,7,16,.25))}
.album .cap{position:absolute;width:40%;z-index:3;opacity:.55}

/* ===== JOURNEY (halaman visa penuh cap) ===== */
.journey{min-height:650px;background:
   repeating-linear-gradient(0deg,transparent 0 22px,rgba(74,14,28,.05) 22px 23px),
   radial-gradient(ellipse at 50% 50%,#FBF6EC 0,#F1E6D0 100%);
  padding:48px 0 135px;min-height:640px}
.journey .visa{position:absolute;inset:0;pointer-events:none;z-index:0}
.journey .visa img{position:absolute;filter:saturate(.85)}
.journey .head{display:inline-block;background:var(--burgundy);color:var(--gold);padding:8px 18px;border-radius:6px;font-size:20px;letter-spacing:.12em;font-weight:700;margin:0 0 6px}
.journey .lead{display:inline-block;font-size:13.5px;color:var(--ink);margin:10px 24px 0;background:rgba(251,246,236,.9);padding:4px 10px;border-radius:6px}
.jcard{position:relative;z-index:1;margin:50px 22px 0;background:rgba(74,14,28,.94);color:var(--paper);border-radius:16px;padding:22px 0 18px;box-shadow:0 16px 34px rgba(46,7,16,.3)}
.jcard::before{content:"";position:absolute;inset:6px;border:1px dashed rgba(212,178,106,.6);border-radius:12px;pointer-events:none}
.slider{position:relative}
.track{display:flex;transition:transform .6s ease}
.slide{flex:0 0 100%;padding:0 46px;text-align:left}
.slide h4{font-size:21px;margin:0;color:var(--gold-soft)}
.slide .d{font-size:13.5px;margin:2px 0 10px;color:var(--olive-soft);border-bottom:1px solid rgba(255,255,255,.35);padding-bottom:10px}
.slide p{margin:0;font-size:14.5px}
.nav{position:absolute;top:34%;width:44px;height:44px;border:0;background:transparent;color:var(--gold);font-size:28px;cursor:pointer}
.nav.p{left:0}.nav.n{right:0}
.dots{display:flex;gap:8px;justify-content:center;margin-top:18px}
.dots button{width:10px;height:10px;border-radius:50%;border:0;background:rgba(255,255,255,.35);padding:0;cursor:pointer}
.dots button.on{background:var(--gold)}

/* ===== RSVP ===== */
.rsvp-card{position:relative;background:#fff;border-radius:16px;box-shadow:0 10px 26px rgba(46,7,16,.12);overflow:hidden;text-align:left}
.rsvp-card .top{background:var(--burgundy);color:var(--gold-soft);padding:12px 18px;display:flex;justify-content:space-between;font-size:12px;letter-spacing:.14em}
.rsvp-card form{padding:18px}
.seg{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.seg label{position:relative;display:flex;align-items:center;justify-content:center;text-align:center;min-height:52px;padding:8px;border:1.5px solid #E2D2BF;border-radius:12px;cursor:pointer;font-size:14px;line-height:1.3;background:var(--paper)}
.seg input{position:absolute;opacity:0;pointer-events:none}
.seg label:has(input:checked){border-color:var(--burgundy);background:var(--burgundy);color:var(--paper)}
.seg label:has(input:focus-visible){outline:3px solid var(--gold);outline-offset:2px}
.stepper{display:flex;align-items:center;gap:10px}
.stepper button{width:44px;height:44px;border-radius:50%;border:1.5px solid var(--burgundy);background:#fff;color:var(--burgundy);font-size:22px;cursor:pointer}
.stepper output{min-width:70px;text-align:center;font-weight:700;font-size:18px}
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.ok{display:none;padding:22px 18px;text-align:center}
.ok.show{display:block}
.ok .big{font-family:"Cormorant Garamond",serif;font-size:28px;color:var(--burgundy);font-weight:600}
.link-btn{background:none;border:0;color:var(--burgundy);text-decoration:underline;font:inherit;cursor:pointer;padding:6px}
.wa{display:inline-flex;align-items:center;gap:8px;margin-top:6px;color:var(--olive-dk);font-size:13.5px}
.btn[disabled]{opacity:.6;cursor:wait}

/* ===== WEDDING GIFT ===== */
.gift .cards{display:grid;gap:14px}
.gift .card{background:linear-gradient(135deg,var(--burgundy-soft),var(--burgundy));color:var(--paper);border-radius:16px;padding:20px;text-align:left;position:relative;overflow:hidden;box-shadow:0 10px 24px rgba(46,7,16,.2)}
.gift .card.sea{background:linear-gradient(135deg,#55622C,var(--olive-dk))}
.gift .card::after{content:"";position:absolute;right:-30px;top:-30px;width:120px;height:120px;border-radius:50%;border:16px solid rgba(255,255,255,.08)}
.gift .card .row{display:flex;justify-content:space-between;align-items:center}
.gift .chip{width:40px;height:30px;border-radius:6px;background:linear-gradient(135deg,var(--gold-soft),var(--gold))}
.gift .bank{font-weight:700;letter-spacing:.1em;font-size:15px}
.gift .no{font-size:20px;letter-spacing:.12em;font-weight:700;margin-top:16px}
.gift .card .btn{margin-top:12px;min-height:40px;padding:0 16px;font-size:13px;background:var(--paper);color:var(--burgundy)}
.gift .card.sea .btn{color:var(--olive-dk)}
